# Optional. The dashboard can also store these in SQLite.
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_DONE_LIST=Done

# OpenAI-compatible local server. Ollama: http://127.0.0.1:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_MODEL=

POLL_INTERVAL_SECONDS=60
LOOKBACK_COMMITS=25
MIN_CONFIDENCE=0.72
DRY_RUN=true
AUTO_POLL=true
# tool-free | handwritten | strands
AGENT_MODE=tool-free
GITHUB_WEBHOOK_SECRET=
